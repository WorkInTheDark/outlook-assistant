<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>a4d2c183-08a1-4f06-9c98-ff6bbb8b5117</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Bingsheng Yao</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="RA Reply"/>
  <Description DefaultValue="Drafts replies to student research inquiries from your playbook."/>
  <IconUrl DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://www.bingshengyao.com/"/>
  <AppDomains>
    <AppDomain>https://www.bingshengyao.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://www.bingshengyao.com/outlook-assistant/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.3">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>

            <!-- Reading an email: the main panel. -->
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="raReplyReadGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="raReplyReadButton">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>

            <!-- Writing a reply: add the CCs or insert the draft. -->
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="raReplyComposeGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="raReplyComposeButton">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="ComposeButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>

          <MobileFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <Group id="raReplyMobileGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="MobileButton" id="raReplyMobileButton">
                  <Label resid="Button.Label"/>
                  <Icon xsi:type="bt:MobileIconList">
                    <bt:Image size="25" scale="1" resid="Icon.25"/>
                    <bt:Image size="25" scale="2" resid="Icon.50"/>
                    <bt:Image size="25" scale="3" resid="Icon.75"/>
                    <bt:Image size="32" scale="1" resid="Icon.32"/>
                    <bt:Image size="32" scale="2" resid="Icon.64"/>
                    <bt:Image size="32" scale="3" resid="Icon.96"/>
                    <bt:Image size="48" scale="1" resid="Icon.48"/>
                    <bt:Image size="48" scale="2" resid="Icon.96"/>
                    <bt:Image size="48" scale="3" resid="Icon.144"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-16.png"/>
          <bt:Image id="Icon.25" DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-25.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-32.png"/>
          <bt:Image id="Icon.48" DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-48.png"/>
          <bt:Image id="Icon.50" DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-50.png"/>
          <bt:Image id="Icon.64" DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-64.png"/>
          <bt:Image id="Icon.75" DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-75.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-80.png"/>
          <bt:Image id="Icon.96" DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-96.png"/>
          <bt:Image id="Icon.144" DefaultValue="https://www.bingshengyao.com/outlook-assistant/assets/icon-144.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Taskpane.Url" DefaultValue="https://www.bingshengyao.com/outlook-assistant/taskpane.html"/>
          <bt:Url id="Commands.Url" DefaultValue="https://www.bingshengyao.com/outlook-assistant/commands.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="RA Reply"/>
          <bt:String id="Button.Label" DefaultValue="RA Reply"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tooltip" DefaultValue="Draft a reply to this student inquiry from your playbook."/>
          <bt:String id="ComposeButton.Tooltip" DefaultValue="Add colleagues to CC or insert the latest draft."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
